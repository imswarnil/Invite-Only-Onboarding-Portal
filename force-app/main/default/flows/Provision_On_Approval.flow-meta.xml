<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <interviewLabel
  >Provision On Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Provision On Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Provisioned_Account</name>
        <label>Create Provisioned Account</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <connector>
            <targetReference>Update_Stage_To_Onboarding</targetReference>
        </connector>
        <inputAssignments>
            <field>Invite_Request__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Products_Live__c</field>

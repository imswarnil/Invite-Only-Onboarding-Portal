        </inputAssignments>
        <object>Provisioned_Account__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Stage_To_Onboarding</name>
        <label>Update Stage To Onboarding</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>Onboarding</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Provisioned_Account</targetReference>
        </connector>
        <object>Invite_Request__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filterFormula
    >AND(ISCHANGED({!$Record.Decision__c}), ISPICKVAL({!$Record.Decision__c}, &quot;Approved&quot;))</filterFormula>
    </start>
    <status>Active</status>
</Flow>

<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Check_Score</name>
        <label>Check Score</label>
        <locationX>264</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>Default (no change)</defaultConnectorLabel>
        <rules>
            <name>High_Score</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Fit_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>75.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_In_Review</targetReference>
            </connector>
            <label>High Score</label>
        </rules>
        <rules>
            <name>Low_Score</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Fit_Score__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>45.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Waitlisted</targetReference>
            </connector>
            <label>Low Score</label>
        </rules>
    </decisions>
    <interviewLabel>Score Routes Stage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Score Routes Stage</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_In_Review</name>
        <label>Set In Review</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>In Review</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Waitlisted</name>
        <label>Set Waitlisted</label>
        <locationX>400</locationX>
        <locationY>350</locationY>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>Waitlisted</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>138</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Score</targetReference>
        </connector>
        <object>Invite_Request__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filterFormula
    >AND(ISCHANGED({!$Record.Fit_Score__c}), NOT(ISBLANK({!$Record.Fit_Score__c})))</filterFormula>
    </start>
    <status>Active</status>
</Flow>
